{
  "name": "paperkite",
  "version": "0.1.3",
  "type": "module",
  "bin": {
    "paperkite": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.14"
  },
  "files": ["dist", "!dist/tests", "data/settings.example.yml", "data/flows.example.yml"],
  "paperkite": {
    "bundles": [
      "@paperkite/plugin-messages",
      "@paperkite/plugin-notify-bark",
      "@paperkite/plugin-messages-watch",
      "@paperkite/plugin-account-health",
      "@paperkite/plugin-archive",
      "@paperkite/plugin-process-run",
      "@paperkite/plugin-runtime-console",
      "@paperkite/plugin-favorites-cleanup"
    ]
  },
  "scripts": {
    "dev": "tsx --conditions=development src/cli.ts",
    "build": "pnpm build:web && pnpm -r build && pnpm build:core",
    "build:core": "tsc -p tsconfig.json",
    "build:web": "pnpm --filter @paperkite/plugin-archive build:web && pnpm --filter @paperkite/plugin-runtime-console build:web",
    "start": "node dist/src/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r typecheck",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@paperkite/plugin-account-health": "workspace:*",
    "@paperkite/plugin-notify-bark": "workspace:*",
    "@paperkite/plugin-runtime-console": "workspace:*",
    "@paperkite/plugin-messages-watch": "workspace:*",
    "@paperkite/plugin-archive": "workspace:*",
    "@paperkite/plugin-process-run": "workspace:*",
    "@paperkite/plugin-favorites-cleanup": "workspace:*",
    "@paperkite/plugin-messages": "workspace:*",
    "@paperkite/sdk": "workspace:*",
    "commander": "^15.0.0",
    "cron-parser": "^5.10.0",
    "telegram": "^2.26.22",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  }
}
