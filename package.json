{
  "name": "paperkite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "paperkite": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.14"
  },
  "paperkite": {
    "bundles": [
      "@paperkite/plugin-telegram-messages",
      "@paperkite/plugin-bark",
      "@paperkite/plugin-conversation-watch",
      "@paperkite/plugin-account-watch",
      "@paperkite/plugin-message-archive",
      "@paperkite/plugin-process-command",
      "@paperkite/plugin-console-web"
    ]
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && pnpm --filter @paperkite/plugin-console-web build:web && pnpm --filter @paperkite/plugin-message-archive build:web",
    "start": "node --import tsx/esm dist/src/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @paperkite/plugin-console-web typecheck:web && pnpm --filter @paperkite/plugin-message-archive typecheck:web",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@paperkite/plugin-account-watch": "workspace:*",
    "@paperkite/plugin-bark": "workspace:*",
    "@paperkite/plugin-console-web": "workspace:*",
    "@paperkite/plugin-conversation-watch": "workspace:*",
    "@paperkite/plugin-message-archive": "workspace:*",
    "@paperkite/plugin-process-command": "workspace:*",
    "@paperkite/plugin-telegram-messages": "workspace:*",
    "@paperkite/sdk": "workspace:*",
    "commander": "^15.0.0",
    "cron-parser": "^5.10.0",
    "telegram": "^2.26.22",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  }
}
