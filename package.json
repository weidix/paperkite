{
  "name": "paperkite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "paperkite": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.14"
  },
  "paperkite": {
    "bundles": [
      "@paperkite/plugin-messages",
      "@paperkite/plugin-notify-bark",
      "@paperkite/plugin-messages-watch",
      "@paperkite/plugin-account-health",
      "@paperkite/plugin-archive",
      "@paperkite/plugin-process-run",
      "@paperkite/plugin-runtime-console"
    ]
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && pnpm --filter @paperkite/plugin-runtime-console build:web && pnpm --filter @paperkite/plugin-archive build:web",
    "start": "node --import tsx/esm dist/src/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @paperkite/plugin-runtime-console typecheck:web && pnpm --filter @paperkite/plugin-archive typecheck:web",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@paperkite/plugin-account-health": "workspace:*",
    "@paperkite/plugin-notify-bark": "workspace:*",
    "@paperkite/plugin-runtime-console": "workspace:*",
    "@paperkite/plugin-messages-watch": "workspace:*",
    "@paperkite/plugin-archive": "workspace:*",
    "@paperkite/plugin-process-run": "workspace:*",
    "@paperkite/plugin-messages": "workspace:*",
    "@paperkite/sdk": "workspace:*",
    "commander": "^15.0.0",
    "cron-parser": "^5.10.0",
    "telegram": "^2.26.22",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  }
}
