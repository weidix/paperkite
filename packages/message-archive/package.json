{
  "name": "@paperkite/plugin-message-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@paperkite/sdk": "workspace:*",
    "fastify": "^5.12.1",
    "pg": "^8.16.3",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.7",
    "typescript": "catalog:",
    "vite": "^7.0.5"
  },
  "paperkite": {
    "plugin": {
      "entry": "./src/index.ts",
      "capabilities": [
        {
          "kind": "action",
          "name": "archive.sync"
        },
        {
          "kind": "service",
          "name": "archive.console_web"
        }
      ]
    }
  }
}