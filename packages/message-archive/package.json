{
  "name": "@paperkite/plugin-message-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@paperkite/sdk": "workspace:*",
    "fastify": "^5.12.1",
    "pg": "^8.16.3",
    "telegram": "^2.26.22"
  },
  "paperkite": {
    "plugin": {
      "entry": "./src/index.ts",
      "capabilities": [
        { "kind": "action", "name": "archive.sync" },
        { "kind": "service", "name": "archive.console_web" }
      ]
    }
  }
}