{
  "name": "@paperkite/plugin-console-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:web": "cd web && rm -rf ../public && vite build",
    "typecheck:web": "cd web && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev:web": "cd web && vite dev"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@paperkite/sdk": "workspace:*",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.0",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.9.3",
    "vite": "^7.0.5",
    "@internationalized/date": "^3.8.1"
  },
  "paperkite": {
    "plugin": {
      "entry": "./src/index.ts",
      "capabilities": [
        {
          "kind": "service",
          "name": "runtime.console_web"
        }
      ]
    }
  }
}
