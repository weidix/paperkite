{
  "name": "@paperkite/plugin-messages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@paperkite/sdk": "workspace:*",
    "luxon": "^3.7.2"
  },
  "paperkite": {
    "plugin": {
      "entry": "./src/index.ts",
      "capabilities": [
        { "kind": "action", "name": "messages.send", "handler": "SendMessageAction" }
      ]
    }
  }
}
