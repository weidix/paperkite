{
  "name": "@paperkite/plugin-favorites-repost",
  "version": "0.1.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weidix/paperkite.git",
    "directory": "packages/favorites-repost"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@paperkite/sdk": "workspace:*"
  },
  "paperkite": {
    "plugin": {
      "entry": "./dist/index.js",
      "capabilities": [
        {
          "kind": "action",
          "name": "favorites.repost",
          "handler": "FavoritesRepostAction"
        }
      ]
    }
  }
}
