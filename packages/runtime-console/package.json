{
  "name": "@paperkite/plugin-runtime-console",
  "version": "0.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weidix/paperkite.git",
    "directory": "packages/runtime-console"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "public"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "cd web && rm -rf ../public && vite build",
    "typecheck:web": "cd web && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev:web": "cd web && vite dev"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "@internationalized/date": "^3.8.1",
    "@paperkite/sdk": "workspace:*",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.0",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.9.3",
    "vite": "^7.0.5"
  },
  "paperkite": {
    "plugin": {
      "entry": "./dist/index.js",
      "capabilities": [
        {
          "kind": "service",
          "name": "runtime.console",
          "handler": "RuntimeConsoleWebService",
          "control": true
        }
      ]
    }
  }
}