{
  "name": "@paperkite/plugin-account-health",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@paperkite/sdk": "workspace:*"
  },
  "paperkite": {
    "plugin": {
      "entry": "./src/index.ts",
      "capabilities": [
        { "kind": "trigger", "name": "account.health", "handler": "SessionHealthTrigger", "control": true }
      ]
    }
  }
}
