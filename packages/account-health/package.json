{
  "name": "@paperkite/plugin-account-health",
  "version": "0.1.1",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@paperkite/sdk": "workspace:*"
  },
  "paperkite": {
    "plugin": {
      "entry": "./dist/index.js",
      "capabilities": [
        { "kind": "trigger", "name": "account.health", "handler": "SessionHealthTrigger", "control": true }
      ]
    }
  }
}