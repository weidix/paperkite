{
  "name": "@paperkite/plugin-favorites-cleanup",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weidix/paperkite.git",
    "directory": "packages/favorites-cleanup"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@paperkite/sdk": "workspace:*"
  },
  "paperkite": {
    "plugin": {
      "entry": "./dist/index.js",
      "capabilities": [
        { "kind": "action", "name": "favorites.cleanup", "handler": "FavoritesCleanupAction" }
      ]
    }
  }
}